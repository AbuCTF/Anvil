# cp .env.example .env — then fill in your secrets
# generate: openssl rand -base64 32 (db), openssl rand -hex 64 (jwt)
# wireguard: wg genkey | tee /tmp/priv | wg pubkey > /tmp/pub

ANVIL_ENV=production

ANVIL_SERVER_PORT=8080
ANVIL_SERVER_HOST=0.0.0.0
PUBLIC_API_URL=https://your-domain.com

# database — use `openssl rand -base64 32` for password
ANVIL_DATABASE_HOST=postgres
ANVIL_DATABASE_PORT=5432
ANVIL_DATABASE_USER=anvil
ANVIL_DATABASE_PASSWORD=
ANVIL_DATABASE_DATABASE=anvil
ANVIL_DATABASE_SSL_MODE=disable

# persistent challenge attachments and uploaded images
ANVIL_STORAGE_PATH=/var/lib/anvil/storage
ANVIL_STORAGE_HOST_PATH=./data/storage

# auth — use `openssl rand -hex 64`
ANVIL_JWT_SECRET=
ANVIL_JWT_ACCESS_EXPIRY=15m
ANVIL_JWT_REFRESH_EXPIRY=168h

# containers
ANVIL_CONTAINER_NETWORK_NAME=anvil-challenges
ANVIL_CONTAINER_NETWORK_SUBNET=172.20.0.0/16
ANVIL_CONTAINER_DEFAULT_TIMEOUT=2h
ANVIL_CONTAINER_MAX_PER_USER=2

# vpn — use `wg genkey | tee /tmp/priv | wg pubkey > /tmp/pub`
ANVIL_VPN_ENABLED=true
ANVIL_VPN_INTERFACE=wg0
ANVIL_VPN_LISTEN_PORT=51820
ANVIL_VPN_PUBLIC_ENDPOINT=
ANVIL_VPN_PRIVATE_KEY=
ANVIL_VPN_PUBLIC_KEY=
ANVIL_VPN_ADDRESS_RANGE=10.10.0.0/16
ANVIL_VPN_DNS=1.1.1.1

# platform
ANVIL_PLATFORM_NAME=Anvil
ANVIL_PLATFORM_REGISTRATION_MODE=open
ANVIL_PLATFORM_SCORING_ENABLED=true
ANVIL_PLATFORM_SCOREBOARD_ENABLED=true

# rate limiting
ANVIL_RATE_LIMIT_ENABLED=true
ANVIL_RATE_LIMIT_REQUESTS_PER_MINUTE=300
