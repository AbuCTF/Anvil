# pin terraform + providers so a rebuild months from now behaves identically.
terraform {
  required_version = ">= 1.9"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # state starts local (on atom) for the first foundation apply, then migrates
  # to a GCS bucket once the bucket exists. see README.
  # backend "gcs" { bucket = "h7ctf26-tfstate" prefix = "gke" }
}

provider "google" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}
