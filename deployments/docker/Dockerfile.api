# syntax=docker/dockerfile:1.7
# Anvil API Dockerfile
FROM golang:1.26-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Copy source code
COPY . .

# Build the binary
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o anvil ./cmd/server

# Final stage
FROM alpine:3.24

# wireguard-tools for wg peer management via nsenter
# openssh-client for remote VM node operations
# qemu-img for converting VMDK to QCOW2
RUN apk add --no-cache ca-certificates tzdata wireguard-tools openssh-client qemu-img

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/anvil .
COPY --from=builder /app/config/config.yaml ./config/

# Create directories for uploads and templates
RUN mkdir -p /var/lib/anvil/images/uploads /var/lib/anvil/images/templates

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health | grep -q '"status":"healthy"' || exit 1

ENTRYPOINT ["./anvil"]
