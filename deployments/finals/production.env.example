# Install the real file as /etc/anvil/finals.env with owner root and mode 0600.
# Generate each secret independently with: openssl rand -hex 32
ANVIL_PRIVATE_ADDRESS=10.60.200.10
PUBLIC_API_URL=https://finals.h7tex.com

ANVIL_DATABASE_PASSWORD=replace-with-an-independent-random-value
ANVIL_JWT_SECRET=replace-with-an-independent-random-value
ANVIL_SECRETS_ENCRYPTION_KEY=replace-with-an-independent-random-value
ANVIL_GAME_INTERNAL_TOKEN=replace-with-an-independent-random-value

# Keep this false until the external gateway passes its end-to-end gate. The
# gateway public key is safe to distribute; its private key must stay on the
# gateway pair and must never be added to Anvil environment or configuration.
ANVIL_VPN_ENABLED=false
ANVIL_VPN_PEER_CONTROL=external
ANVIL_VPN_PUBLIC_ENDPOINT=vpn.h7tex.com:443
ANVIL_VPN_PUBLIC_KEY=
ANVIL_VPN_ALLOWED_IPS=10.60.0.0/15

ANVIL_TLS_CERT_PATH=/etc/anvil/tls/fullchain.pem
ANVIL_TLS_KEY_PATH=/etc/anvil/tls/privkey.pem
ANVIL_DATABASE_HOST_PATH=/srv/anvil/postgres
ANVIL_STORAGE_HOST_PATH=/srv/anvil/storage
ANVIL_BACKUP_DIR=/srv/anvil/backups
